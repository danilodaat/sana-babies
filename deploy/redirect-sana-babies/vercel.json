{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/((?!sw\\.js$).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/sw.js", "headers": [{ "key": "Content-Type", "value": "application/javascript; charset=utf-8" }] }
  ]
}
